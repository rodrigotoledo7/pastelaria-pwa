# Configurações do Supabase
# Obtenha estas credenciais no painel do Supabase: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://sua-url-supabase.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# (Opcional) OpenRouteService API Key para cálculo de rotas viárias na Edge Function
# Obtenha em: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=
